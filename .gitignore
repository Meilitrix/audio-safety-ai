# browser audit screenshots - local working notes, not part of the app
audit_*.png
verify_*.png
step*_*.png

# ── Third-party sample clips ──
# sfx_training/ holds downloaded Freesound recordings used to train the classifier.
# They are licensed to their original authors (attribution required) and are NOT
# ours to publish, so they stay on the development machine only. The training and
# evaluation scripts read them by path; the running app does not need them.
sfx_training/

